#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
# The app's executable: beside resources/ on Linux (the .deb links /usr/bin/harness-studio to this launcher), in
# Contents/MacOS on macOS.
case "$(uname -s)" in
  Linux) executable=$resources/../harness-studio ;;
  *) executable="$resources/../MacOS/Harness Studio" ;;
esac
# Harness Studio keeps its settings, keys and sessions in ~/.harness-studio, like the app; an explicit
# DSH_HOME still wins.
: "${DSH_HOME:=$HOME/.harness-studio}"
export DSH_HOME
# A task with no mode runs one headless session in Harness Studio's command-line profile, which adds its
# connectors, memory and hooks to the base composition. Launcher modes, flags and named profiles pass through.
case "${1-}" in
  web|plugin|acp|headless|sdk|sdk-minimal|desktop|harness-studio|--profile|--profile=*|--from-default-profile|--from-default-profile=*|--dump-config|--dump-default-config|--dump-config-schema|--version|-V|--help|-h) ;;
  *) set -- --profile harness-studio "$@" ;;
esac
ELECTRON_RUN_AS_NODE=1 exec "$executable" --expose-internals "$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js" "$@"
